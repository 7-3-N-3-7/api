{
  "mcpServers": {
    "chrome-devtools": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--cap-add=SYS_ADMIN",
        "--network=api_public-net",
        "ghcr.io/puppeteer/puppeteer:latest",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-sandbox"
      ]
    }
  }
}
