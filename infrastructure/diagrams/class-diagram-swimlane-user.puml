@startuml
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

title Swimlane 4: User & Identity Management Flow (/api/users & /api/v1/profile)

package "1. Route & Controller Swimlane" as LaneCtrl #EBF5FB {
    abstract class "BaseController<User, UserRequestDto, UUID>" as BaseCtrl <<AbstractController>> {
        #service: BaseService<User, UserRequestDto, UUID> <<@Autowired>>
        +getAll(): ResponseEntity<List<UserRequestDto>>
        +getById(id: UUID): ResponseEntity<UserRequestDto>
        +create(dto: UserRequestDto): ResponseEntity<?>
        +update(id: UUID, dto: UserRequestDto): ResponseEntity<?>
        +delete(id: UUID): ResponseEntity<Void>
    }

    class UserController <<@RestController /api/users>> {
        -userService: UserService
        +create(request: UserRequestDto): ResponseEntity<?> <<@PostMapping>>
        +createUser(request: UserRequestDto): ResponseEntity<?>
        +handleValidationExceptions(ex: MethodArgumentNotValidException): ResponseEntity<String> <<@ExceptionHandler>>
    }

    class ProfileController <<@RestController /api/v1/profile>> {
        +getUserProfile(authentication: Authentication): ResponseEntity<Map<String, String>> <<@GetMapping>>
    }

    class SecurityConfig <<@Configuration @EnableWebSecurity>> {
        +filterChain(http: HttpSecurity): SecurityFilterChain
        +jwtAuthenticationConverter(): JwtAuthenticationConverter
        +passwordEncoder(): PasswordEncoder
    }
}

package "2. DTO Swimlane" as LaneDto #FEF9E7 {
    interface "BaseDTO<UUID>" as BaseDto <<Serializable>> {
        +getId(): UUID
        +setId(id: UUID): void
    }

    class UserRequestDto <<implements BaseDTO<UUID>>> {
        -id: UUID
        -username: String <<@NotBlank>>
        -password: String <<@NotBlank>>
        -role: String <<@Pattern("CLIENT|THERAPIST")>>
    }

    class UserResponseDto <<implements BaseDTO<UUID>>> {
        -id: UUID
        -username: String
        -role: String
    }
}

package "3. Service Swimlane" as LaneSvc #F4ECF7 {
    class "BaseService<User, UserRequestDto, UUID>" as BaseSvc <<@Transactional>> {
        #repository: BaseRepository<User, UUID> <<@Autowired>>
        +toEntity(dto: UserRequestDto): User
        +toDto(entity: User): UserRequestDto
        +create(entity: User): User
    }

    class UserService <<@Service>> {
        -userRepository: UserRepository
        -passwordEncoder: PasswordEncoder
        +toEntity(request: UserRequestDto): User
        +toDto(entity: User): UserRequestDto
        +createUser(request: UserRequestDto): UserResponseDto
    }
}

package "4. Repository Swimlane" as LaneRepo #E8F8F5 {
    interface "BaseRepository<User, UUID>" as BaseRepo <<@NoRepositoryBean>> {
    }

    interface UserRepository <<@Repository>> {
        +existsByUsername(username: String): boolean
        +findByUsername(username: String): Optional<User>
    }
}

package "5. Hibernate Entity Swimlane" as LaneEntity #FDEDEC {
    abstract class "BaseEntity<UUID>" as BaseEnt <<@MappedSuperclass>> {
        #id: UUID <<@Id @GeneratedValue(UUID)>>
        +getId(): UUID
        +setId(id: UUID): void
    }

    class "User" as UserEntity <<@Entity app_users>> {
        -username: String <<@Column(unique=true)>>
        -password: String
        -role: String
    }
}

BaseCtrl <|-- UserController
BaseDto <|.. UserRequestDto
BaseDto <|.. UserResponseDto
BaseSvc <|-- UserService
BaseRepo <|-- UserRepository
BaseEnt <|-- UserEntity

SecurityConfig ..> UserController : "Keycloak OAuth2 JWT Filter"
SecurityConfig ..> ProfileController : "Keycloak OAuth2 JWT Filter"
UserController --> UserService : "@Autowired service"
UserController ..> UserRequestDto : "@Valid @RequestBody"
UserController ..> UserResponseDto : "Returns 201 Created"
UserService ..> UserRequestDto : "toEntity / BCrypt hash"
UserService ..> UserResponseDto : "Maps saved entity"
UserService --> UserRepository : "@Autowired repository"
UserRepository --> UserEntity : "Hibernate ORM"

@enduml
