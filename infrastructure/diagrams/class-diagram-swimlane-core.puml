@startuml
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

title Swimlane 0: Generic Core Framework (Route -> BaseController -> BaseService -> BaseRepository -> BaseEntity/BaseDTO -> Hibernate)

package "1. Route & Interface Swimlane (com.platform.core.controller)" as LaneCtrl #EBF5FB {
    abstract class "BaseController<Entity extends BaseEntity<ID>, DTO extends BaseDTO<ID>, ID extends Serializable>" as BaseController <<AbstractController>> {
        #service: BaseService<Entity, DTO, ID> <<@Autowired(required=false)>>
        #BaseController()
        #BaseController(service: BaseService<Entity, DTO, ID>)
        +getService(): BaseService<Entity, DTO, ID>
        +setService(service: BaseService<Entity, DTO, ID>): void
        +getAll(): ResponseEntity<List<DTO>> <<@GetMapping>>
        +getById(id: ID): ResponseEntity<DTO> <<@GetMapping("/{id}")>>
        +create(dto: DTO): ResponseEntity<?> <<@PostMapping>>
        +update(id: ID, dto: DTO): ResponseEntity<?> <<@PutMapping("/{id}")>>
        +delete(id: ID): ResponseEntity<Void> <<@DeleteMapping("/{id}")>>
    }
}

package "2. DTO Contract Swimlane (com.platform.core.dto)" as LaneDto #FEF9E7 {
    interface "BaseDTO<ID extends Serializable>" as BaseDTO <<Serializable>> {
        +getId(): ID
        +setId(id: ID): void
    }
}

package "3. Application & Business Logic Swimlane (com.platform.core.service)" as LaneSvc #F4ECF7 {
    class "BaseService<Entity extends BaseEntity<ID>, DTO extends BaseDTO<ID>, ID extends Serializable>" as BaseService <<@Transactional>> {
        #repository: BaseRepository<Entity, ID> <<@Autowired(required=false)>>
        #interceptors: List<CrudInterceptor<Entity, ID>>
        #entityClass: Class<Entity>
        #dtoClass: Class<DTO>
        +BaseService()
        +BaseService(repository: BaseRepository<Entity, ID>)
        +getRepository(): BaseRepository<Entity, ID>
        +setRepository(repository: BaseRepository<Entity, ID>): void
        +getEntityClass(): Class<Entity>
        +setEntityClass(entityClass: Class<Entity>): void
        +getDtoClass(): Class<DTO>
        +setDtoClass(dtoClass: Class<DTO>): void
        +setInterceptors(discoveredInterceptors: List<CrudInterceptor<Entity, ID>>): void <<@Autowired(required=false)>>
        +addInterceptor(interceptor: CrudInterceptor<Entity, ID>): void
        +getInterceptors(): List<CrudInterceptor<Entity, ID>>
        +toEntity(dto: DTO): Entity
        +toDto(entity: Entity): DTO
        +findAll(): List<Entity> <<@Transactional(readOnly=true)>>
        +findAllDtos(): List<DTO> <<@Transactional(readOnly=true)>>
        +findAllDynamic(offset: int, limit: int, filters: Map<String, String>, sortParam: String): List<Entity> <<@Transactional(readOnly=true)>>
        +findById(id: ID): Optional<Entity> <<@Transactional(readOnly=true)>>
        +findDtoById(id: ID): Optional<DTO> <<@Transactional(readOnly=true)>>
        +getByIdOrThrow(id: ID): Entity <<@Transactional(readOnly=true)>>
        +create(entity: Entity): Entity
        +createFromDto(dto: DTO): DTO
        +save(entity: Entity): Entity
        +update(id: ID, entity: Entity): Entity
        +updateFromDto(id: ID, dto: DTO): DTO
        +deleteById(id: ID): void
        +existsById(id: ID): boolean <<@Transactional(readOnly=true)>>
        +count(): long <<@Transactional(readOnly=true)>>
        +buildSpecification(filters: Map<String, String>): Specification<Entity>
        +buildSort(sortParam: String): Sort
        #convertFilterValue(val: String, targetType: Class<?>): Object
    }

    interface "CrudInterceptor<Entity extends BaseEntity<ID>, ID extends Serializable>" as CrudInterceptor <<LifecycleHook>> {
        +beforeCreate(entity: Entity): void
        +afterCreate(entity: Entity): void
        +beforeUpdate(entity: Entity): void
        +afterUpdate(entity: Entity): void
        +beforeDelete(id: ID): void
        +afterDelete(id: ID): void
    }
}

package "4. Data Access & Repository Swimlane (com.platform.core.repository & dao)" as LaneRepo #E8F8F5 {
    interface "BaseRepository<Entity extends BaseEntity<ID>, ID extends Serializable>" as BaseRepository <<@NoRepositoryBean>> {
        ' Extends JpaRepository<Entity, ID> & JpaSpecificationExecutor<Entity>
        +findAll(spec: Specification<Entity>, pageable: Pageable): Page<Entity>
        +findAll(spec: Specification<Entity>, sort: Sort): List<Entity>
    }

    abstract class "BaseDAO<T extends BaseEntity<ID>, ID extends Serializable>" as BaseDAO <<GenericCriteriaDAO>> {
        #entityManager: EntityManager <<@PersistenceContext>>
        #entityClass: Class<T>
        +findAll(): List<T>
        +findById(id: ID): Optional<T>
        +save(entity: T): T
        +deleteById(id: ID): void
        +existsById(id: ID): boolean
        +count(): long
        +findAllDynamic(offset: int, limit: int, filters: Map<String, String>, sortParam: String): List<T>
        #convertValue(val: String, targetType: Class<?>): Object
    }
}

package "5. Hibernate ORM & Entity Swimlane (com.platform.core.entity)" as LaneEntity #FDEDEC {
    abstract class "BaseEntity<ID extends Serializable>" as BaseEntity <<@MappedSuperclass>> {
        #id: ID <<@Id @GeneratedValue(strategy=UUID)>>
        +getId(): ID
        +setId(id: ID): void
    }

    abstract class "BaseEntity.UuidEntity" as UuidEntity <<@MappedSuperclass>> {
        +getId(): UUID
        +setId(id: UUID): void
    }
}

BaseController --> BaseService : "@Autowired Spring IoC\nResolvableType<Entity, DTO, ID>"
BaseController ..> BaseDTO : "Request / Response DTO"
BaseService --> BaseRepository : "@Autowired Spring IoC\nResolvableType<Entity, ID>"
BaseService o-- CrudInterceptor : "@Autowired lifecycle hooks"
BaseService ..> BaseDTO : "BeanUtils toEntity(DTO) / toDto(Entity)"
BaseService ..> BaseEntity : "Manages @Transactional Entity"
BaseRepository --> BaseEntity : "Hibernate Session /PreparedStatement"
BaseDAO --> BaseEntity : "JPA CriteriaBuilder"
BaseDTO <|.. BaseEntity
BaseEntity <|-- UuidEntity

@enduml
