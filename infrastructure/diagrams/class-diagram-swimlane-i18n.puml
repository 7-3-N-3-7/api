@startuml
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

title Swimlane 6: I18n Localization & MongoDB Dictionary Flow (/api/v1/i18n)

package "1. Route & Startup Swimlane" as LaneCtrl #EBF5FB {
    class I18nController <<@RestController /api/v1/i18n>> {
        -i18nService: I18nService
        +getLocales(ref: String): ResponseEntity<List<Map<String, Object>>> <<@GetMapping("/locales")>>
        +createOrUpdateLocale(payload: Map<String, Object>): ResponseEntity<I18nDictionary> <<@PostMapping("/locales")>>
        +updateLocaleStatus(locale: String, payload: Map<String, Object>): ResponseEntity<I18nDictionary> <<@PatchMapping("/locales/{locale}/status")>>
        +deleteLocale(locale: String): ResponseEntity<Map<String, Object>> <<@DeleteMapping("/locales/{locale}")>>
        +getRawDocument(locale: String): ResponseEntity<I18nDictionary> <<@GetMapping("/document/{locale}")>>
        +replaceRawTranslations(locale: String, payload: Map<String, Object>): ResponseEntity<I18nDictionary> <<@PutMapping("/document/{locale}")>>
        +getDictionary(locale: String): ResponseEntity<Map<String, Object>> <<@GetMapping("/{locale}")>>
        +updateTranslation(locale: String, key: String, req: TranslationUpdateRequest): ResponseEntity<Void> <<@PutMapping("/{locale}/{key}")>>
        +deleteTranslationKey(locale: String, key: String): ResponseEntity<Void> <<@DeleteMapping("/{locale}/{key}")>>
    }

    class ClinicDatabaseInitializer <<@Component CommandLineRunner>> {
        -i18nDictionaryRepository: I18nDictionaryRepository
        +run(args: String...): void
        -seedLocale(locale: String, displayName: String, flag: String, translations: Map<String, Object>): void
    }
}

package "2. DTO Swimlane" as LaneDto #FEF9E7 {
    class TranslationUpdateRequest <<DTO>> {
        -value: String
        +getValue(): String
        +setValue(value: String): void
    }
}

package "3. Service Swimlane" as LaneSvc #F4ECF7 {
    class I18nService <<@Service>> {
        -{static} DEFAULT_LOCALE_META: Map<String, String[]>
        -repository: I18nDictionaryRepository
        +getDictionary(locale: String): Optional<I18nDictionary>
        +getAllDictionaries(): List<I18nDictionary>
        +updateTranslation(locale: String, key: String, value: String): I18nDictionary
        +deleteTranslationKey(locale: String, key: String): I18nDictionary
        +createOrUpdateLocale(locale: String, displayName: String, flag: String, published: Boolean, cloneFromLocale: String, copyValues: boolean): I18nDictionary
        +replaceDictionaryTranslations(locale: String, translations: Map<String, Object>): I18nDictionary
        +deleteLocale(locale: String): void
        +getLocaleSummaries(referenceLocale: String): List<Map<String, Object>>
        +{static} flattenMap(map: Map<String, Object>, prefix: String): Map<String, String>
    }
}

package "4. Repository Swimlane (Spring Data MongoDB)" as LaneRepo #E8F8F5 {
    interface "MongoRepository<I18nDictionary, String>" as MongoRepo <<SpringDataMongoDB>> {
    }

    interface I18nDictionaryRepository <<@Repository>> {
        +findByLocale(locale: String): Optional<I18nDictionary>
    }
}

package "5. Document Model Swimlane (MongoDB)" as LaneEntity #FDEDEC {
    class I18nDictionary <<@Document(collection="i18n_dictionaries")>> {
        -id: String <<@Id>>
        -locale: String <<@Indexed(unique=true)>>
        -displayName: String
        -flag: String
        -published: Boolean
        -updatedAt: Instant
        -translations: Map<String, Object>
    }
}

MongoRepo <|-- I18nDictionaryRepository
I18nController --> I18nService : "@Autowired"
I18nController ..> TranslationUpdateRequest : "@RequestBody"
I18nService --> I18nDictionaryRepository : "@Autowired"
ClinicDatabaseInitializer --> I18nDictionaryRepository : "Seeds en, da, fr, es, de"
I18nDictionaryRepository --> I18nDictionary : "MongoDB Document Store"

@enduml
