@startuml
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

title Swimlane 2: Journal, Clinical Notes & JGit Versioning Flow (/api/v1/journals)

package "1. Route & Controller Swimlane" as LaneCtrl #EBF5FB {
    abstract class "BaseController<JournalEntry, JournalEntryDto, UUID>" as BaseCtrl <<AbstractController>> {
        #service: BaseService<JournalEntry, JournalEntryDto, UUID> <<@Autowired>>
        +getAll(): ResponseEntity<List<JournalEntryDto>>
        +getById(id: UUID): ResponseEntity<JournalEntryDto>
        +create(dto: JournalEntryDto): ResponseEntity<?>
        +update(id: UUID, dto: JournalEntryDto): ResponseEntity<?>
        +delete(id: UUID): ResponseEntity<Void>
    }

    class JournalController <<@RestController /api/v1/journals>> {
        -journalService: JournalService
        +create(dto: JournalEntryDto): ResponseEntity<JournalEntry> <<@PostMapping>>
        +createJournalEntry(dto: JournalEntryDto, auth: Authentication): ResponseEntity<JournalEntry>
        +updateJournalEntrySharing(entryId: UUID, payload: Map<String, Object>, auth: Authentication): ResponseEntity<JournalEntry> <<@PatchMapping("/{entryId}/sharing")>>
        +createTherapistNote(payload: Map<String, Object>, auth: Authentication): ResponseEntity<?> <<@PostMapping("/therapist-notes")>>
        +getClientJournalBundle(clientUuid: UUID, therapistUuid: UUID, auth: Authentication): ResponseEntity<Map<String, Object>> <<@GetMapping("/client/{clientUuid}")>>
        +getJournalCommitHistory(clientUuid: UUID, therapistUuid: UUID, auth: Authentication): ResponseEntity<List<Map<String, String>>> <<@GetMapping("/history/{clientUuid}")>>
        +getClientTimeline(clientUuid: UUID, auth: Authentication): ResponseEntity<List<Map<String, String>>> <<@GetMapping("/timeline/{clientUuid}")>>
    }
}

package "2. DTO Swimlane" as LaneDto #FEF9E7 {
    interface "BaseDTO<UUID>" as BaseDto <<Serializable>> {
        +getId(): UUID
        +setId(id: UUID): void
    }

    class JournalEntryDto <<implements BaseDTO<UUID>>> {
        -id: UUID
        -clientUuid: UUID
        -appointmentId: UUID
        -title: String
        -content: String
        -moodRating: Integer
        -sharedWithTherapists: Boolean
        -sharedTherapistUuids: List<UUID>
    }
}

package "3. Service & JGit Versioning Swimlane" as LaneSvc #F4ECF7 {
    class "BaseService<JournalEntry, JournalEntryDto, UUID>" as BaseSvc <<@Transactional>> {
        #repository: BaseRepository<JournalEntry, UUID> <<@Autowired>>
        +toEntity(dto: JournalEntryDto): JournalEntry
        +toDto(entity: JournalEntry): JournalEntryDto
    }

    class JournalService <<@Service>> {
        -{static} INTERNAL_NOTES_MARKER: String
        -journalEntryRepository: JournalEntryRepository
        -journalGitService: JournalGitService
        -clinicalNoteRepository: TherapistClinicalNoteRepository
        -cacheService: PlatformCacheService
        -appointmentRepository: AppointmentRepository
        -handshakeRepository: HandshakeRepository
        +toEntity(dto: JournalEntryDto): JournalEntry
        +getJournalContent(rawMarkdown: String, isTherapist: boolean): String
        +createJournalEntry(dto: JournalEntryDto, auth: Authentication): JournalEntry
        +updateJournalEntrySharing(entryId: UUID, payload: Map<String, Object>): JournalEntry
        +createTherapistNote(payload: Map<String, Object>, auth: Authentication): TherapistClinicalNote
        +getClientJournalBundle(clientUuid: UUID, therapistUuid: UUID, auth: Authentication): Map<String, Object>
        +getJournalCommitHistory(clientUuid: UUID, therapistUuid: UUID, auth: Authentication): List<Map<String, String>>
        +getClientTimeline(clientUuid: UUID, auth: Authentication): List<Map<String, String>>
        +hasTherapistRole(auth: Authentication): boolean
    }

    class JournalGitService <<@Service (Eclipse JGit)>> {
        -repoPath: String
        -git: Git
        +init(): void
        +commitJournalEntryWithHash(patientId: String, content: String, msg: String, author: String): String
        +readJournalEntry(patientId: String): String
        +getCommitHistory(patientId: String, isTherapist: boolean, journalService: JournalService, from: LocalDate, to: LocalDate, therapistUuid: String): List<Map<String, String>>
    }

    class PlatformCacheService <<@Service>> {
        +put(key: String, value: Object): void
    }
}

package "4. Repository Swimlane" as LaneRepo #E8F8F5 {
    interface "BaseRepository<E, UUID>" as BaseRepo <<@NoRepositoryBean>> {
    }

    interface JournalEntryRepository <<@Repository>> {
        +findByClientUuidOrderByTimestampDesc(clientUuid: UUID): List<JournalEntry>
    }

    interface TherapistClinicalNoteRepository <<@Repository>> {
        +findByClientUuidOrderByCreatedAtDesc(clientUuid: UUID): List<TherapistClinicalNote>
    }

    interface HandshakeRepository <<@Repository>> {
        +findByClientUuidAndTherapistUuid(clientUuid: UUID, therapistUuid: UUID): Optional<ClientTherapistHandshake>
    }

    interface AppointmentRepository <<@Repository>> {
        +findById(id: UUID): Optional<Appointment>
    }
}

package "5. Hibernate Entity Swimlane" as LaneEntity #FDEDEC {
    abstract class "BaseEntity<UUID>" as BaseEnt <<@MappedSuperclass>> {
        #id: UUID <<@Id @GeneratedValue(UUID)>>
    }

    class JournalEntry <<@Entity journal_entries>> {
        -clientUuid: UUID
        -appointmentId: UUID
        -title: String
        -content: String
        -moodRating: Integer
        -sharedWithTherapists: Boolean
        -sharedTherapistUuidsRaw: String
        -gitCommitHash: String
        -timestamp: LocalDateTime
        +isVisibleToTherapist(therapistUuid: UUID): boolean
    }

    class TherapistClinicalNote <<@Entity therapist_clinical_notes>> {
        -clientUuid: UUID
        -authorTherapistUuid: UUID
        -authorTherapistName: String
        -organisationName: String
        -journalEntryId: UUID
        -appointmentId: UUID
        -confidentialMarkdown: String
        -gitCommitHash: String
        -createdAt: LocalDateTime
    }

    class ClientTherapistHandshake <<@Entity client_therapist_handshakes>> {
        -status: String
        -validFrom: LocalDate
        -validTo: LocalDate
        -historyStartDate: LocalDate
        -historyEndDate: LocalDate
        +isCurrentlyValid(): boolean
    }
}

BaseCtrl <|-- JournalController
BaseDto <|.. JournalEntryDto
BaseSvc <|-- JournalService
BaseRepo <|-- JournalEntryRepository
BaseRepo <|-- TherapistClinicalNoteRepository
BaseRepo <|-- HandshakeRepository
BaseRepo <|-- AppointmentRepository
BaseEnt <|-- JournalEntry
BaseEnt <|-- TherapistClinicalNote
BaseEnt <|-- ClientTherapistHandshake

JournalController --> JournalService : "@Autowired service"
JournalController ..> JournalEntryDto : "@RequestBody"
JournalService ..> JournalEntryDto : "toEntity / toDto"
JournalService --> JournalEntryRepository : "@Autowired primary repository"
JournalService --> TherapistClinicalNoteRepository : "Confidential clinical notes"
JournalService --> HandshakeRepository : "Validates active consent & date range"
JournalService --> AppointmentRepository : "Links journalEntryId to Appointment"
JournalService --> JournalGitService : "Commits markdown & strips INTERNAL_MEDICAL_NOTES"
JournalService --> PlatformCacheService : "Updates journal:client:{uuid}"
JournalEntryRepository --> JournalEntry : "Hibernate ORM"
TherapistClinicalNoteRepository --> TherapistClinicalNote : "Hibernate ORM"
HandshakeRepository --> ClientTherapistHandshake : "Hibernate ORM"

@enduml
