@startuml
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

title Swimlane 1: Appointment & Timefold Scheduling Flow (/api/v1/appointments)

package "1. Route & Controller Swimlane" as LaneCtrl #EBF5FB {
    abstract class "BaseController<Appointment, Appointment, UUID>" as BaseCtrl <<AbstractController>> {
        #service: BaseService<Appointment, Appointment, UUID> <<@Autowired>>
        +getAll(): ResponseEntity<List<Appointment>>
        +getById(id: UUID): ResponseEntity<Appointment>
        +create(dto: Appointment): ResponseEntity<?>
        +update(id: UUID, dto: Appointment): ResponseEntity<?>
        +delete(id: UUID): ResponseEntity<Void>
    }

    class AppointmentController <<@RestController /api/v1/appointments>> {
        -appointmentService: AppointmentService
        +getAppointmentsForClient(clientUuid: UUID, from: String, to: String): ResponseEntity<List<Appointment>> <<@GetMapping("/client/{clientUuid}")>>
        +getAppointmentsForTherapist(therapistUuid: UUID): ResponseEntity<List<Appointment>> <<@GetMapping("/therapist/{therapistUuid}")>>
        +getTimefoldOptimalSlots(therapistUuid: UUID, date: String, durationMinutes: int, preferredTime: String, excludeAppointmentId: UUID): ResponseEntity<Map<String, Object>> <<@GetMapping("/timefold-slots")>>
        +create(appointment: Appointment): ResponseEntity<Appointment> <<@PostMapping>>
        +createAppointment(appointment: Appointment): ResponseEntity<Appointment>
        +update(id: UUID, updated: Appointment): ResponseEntity<Appointment> <<@PutMapping("/{id}")>>
        +rescheduleAppointment(id: UUID, updated: Appointment): ResponseEntity<Appointment>
        +delete(id: UUID): ResponseEntity<Void> <<@DeleteMapping("/{id}")>>
        +cancelAppointment(id: UUID): ResponseEntity<Void>
        +getAppointmentGitHistory(id: UUID): ResponseEntity<List<Map<String, String>>> <<@GetMapping("/{id}/git-history")>>
    }
}

package "2. Service & AI Solver Swimlane" as LaneSvc #F4ECF7 {
    class "BaseService<Appointment, Appointment, UUID>" as BaseSvc <<@Transactional>> {
        #repository: BaseRepository<Appointment, UUID> <<@Autowired>>
        +findAll(): List<Appointment>
        +findById(id: UUID): Optional<Appointment>
        +findAllDynamic(offset: int, limit: int, filters: Map, sort: String): List<Appointment>
    }

    class AppointmentService <<@Service>> {
        -appointmentRepository: AppointmentRepository
        -cacheService: PlatformCacheService
        -eventService: PlatformEventService
        -timefoldBookingService: TimefoldBookingService
        -providerProfileRepository: ProviderProfileRepository
        -journalGitService: JournalGitService
        -journalService: JournalService
        +create(entity: Appointment): Appointment
        +update(id: UUID, entity: Appointment): Appointment
        +deleteById(id: UUID): void
        +getAppointmentsForClient(clientUuid: UUID, fromDate: LocalDate, toDate: LocalDate): List<Appointment>
        +getAppointmentsForTherapist(therapistUuid: UUID): List<Appointment>
        +getTimefoldSlotSuggestions(therapistUuid: UUID, date: LocalDate, duration: int, preferredTime: LocalTime, excludeId: UUID): Map<String, Object>
        +createAppointment(appointment: Appointment): Appointment
        +rescheduleAppointment(id: UUID, updated: Appointment): Appointment
        +cancelAppointment(id: UUID): void
        +getAppointmentGitHistory(appointmentId: UUID): List<Map<String, String>>
        +buildClientCacheKey(clientUuid: UUID, fromDate: LocalDate, toDate: LocalDate): String
    }

    class TimefoldBookingService <<@Service>> {
        +suggestOptimalSlots(therapistUuid: UUID, date: LocalDate, durationMinutes: int, preferredTime: LocalTime, existingAppointments: List<Appointment>, profile: ProviderProfile, excludeAppointmentId: UUID): Map<String, Object>
    }

    class JournalGitService <<@Service>> {
        +commitJournalEntryWithHash(patientId: String, content: String, msg: String, author: String): String
        +getCommitHistory(patientId: String, isTherapist: boolean, journalService: JournalService): List<Map<String, String>>
    }

    class PlatformCacheService <<@Service (Redisson/Redis)>> {
        +get(key: String): T
        +put(key: String, val: Object): void
        +evict(key: String): void
        +evictByPrefix(prefix: String): void
    }

    class PlatformEventService <<@Service (Kafka)>> {
        +publishEvent(topic: String, type: String, key: String, payload: Map<String, Object>): void
    }
}

package "3. Repository Swimlane" as LaneRepo #E8F8F5 {
    interface "BaseRepository<Appointment, UUID>" as BaseRepo <<@NoRepositoryBean>> {
    }

    interface AppointmentRepository <<@Repository>> {
        +findByClientUuid(clientUuid: UUID): List<Appointment>
        +findByTherapistUuid(therapistUuid: UUID): List<Appointment>
    }

    interface ProviderProfileRepository <<@Repository>> {
        +findByUserUuid(userUuid: UUID): Optional<ProviderProfile>
    }
}

package "4. Hibernate Entity & DTO Swimlane" as LaneEntity #FDEDEC {
    abstract class "BaseEntity<UUID>" as BaseEnt <<@MappedSuperclass>> {
        #id: UUID <<@Id @GeneratedValue(UUID)>>
        +getId(): UUID
        +setId(id: UUID): void
    }

    class Appointment <<@Entity appointments (implements BaseDTO<UUID>)>> {
        -clientUuid: UUID
        -therapistUuid: UUID
        -serviceId: UUID
        -therapistName: String
        -organisationName: String
        -location: String
        -startTime: LocalDateTime
        -endTime: LocalDateTime
        -title: String
        -status: String
        -gitCommitHash: String
        -journalEntryId: UUID
    }

    class ProviderProfile <<@Entity provider_profiles>> {
        -userUuid: UUID
        -displayName: String
        -workingHoursJson: String
    }
}

BaseCtrl <|-- AppointmentController
BaseSvc <|-- AppointmentService
BaseRepo <|-- AppointmentRepository
BaseEnt <|-- Appointment
BaseEnt <|-- ProviderProfile

AppointmentController --> AppointmentService : "@Autowired service"
AppointmentService --> AppointmentRepository : "@Autowired repository"
AppointmentService --> ProviderProfileRepository : "Working hours lookup"
AppointmentService --> TimefoldBookingService : "Constraint solver"
AppointmentService --> JournalGitService : "JGitRefs-Appointment commit"
AppointmentService --> PlatformCacheService : "Redis cache & evict"
AppointmentService --> PlatformEventService : "Kafka appointment-events"
AppointmentRepository --> Appointment : "Hibernate ORM"
ProviderProfileRepository --> ProviderProfile : "Hibernate ORM"

@enduml
