@startuml
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

title Swimlane 3: Psychotraumatology (PCL-5 Assessments) Flow (/api/v1/psychotraumatology/tests)

package "1. Route & Controller Swimlane" as LaneCtrl #EBF5FB {
    abstract class "BaseController<PsychotraumatologyTest, PsychotraumatologyTestDto, UUID>" as BaseCtrl <<AbstractController>> {
        #service: BaseService<PsychotraumatologyTest, PsychotraumatologyTestDto, UUID> <<@Autowired>>
        +getAll(): ResponseEntity<List<PsychotraumatologyTestDto>>
        +getById(id: UUID): ResponseEntity<PsychotraumatologyTestDto>
        +create(dto: PsychotraumatologyTestDto): ResponseEntity<?>
        +update(id: UUID, dto: PsychotraumatologyTestDto): ResponseEntity<?>
        +delete(id: UUID): ResponseEntity<Void>
    }

    class PsychotraumatologyController <<@RestController /api/v1/psychotraumatology/tests>> {
        -psychotraumatologyService: PsychotraumatologyService
        +create(dto: PsychotraumatologyTestDto): ResponseEntity<PsychotraumatologyTest> <<@PostMapping>>
        +submitTest(dto: PsychotraumatologyTestDto): ResponseEntity<PsychotraumatologyTest>
        +getTestsByClient(clientUuid: UUID, auth: Authentication): ResponseEntity<List<PsychotraumatologyTest>> <<@GetMapping("/client/{clientUuid}")>>
    }
}

package "2. DTO Swimlane" as LaneDto #FEF9E7 {
    interface "BaseDTO<UUID>" as BaseDto <<Serializable>> {
        +getId(): UUID
        +setId(id: UUID): void
    }

    class PsychotraumatologyTestDto <<implements BaseDTO<UUID>>> {
        -id: UUID
        -clientUuid: UUID
        -therapistUuid: UUID
        -testType: String
        -score: Integer
        -severity: String
        -answersJson: String
    }
}

package "3. Service Swimlane" as LaneSvc #F4ECF7 {
    class "BaseService<PsychotraumatologyTest, PsychotraumatologyTestDto, UUID>" as BaseSvc <<@Transactional>> {
        #repository: BaseRepository<PsychotraumatologyTest, UUID> <<@Autowired>>
        +toEntity(dto: PsychotraumatologyTestDto): PsychotraumatologyTest
        +toDto(entity: PsychotraumatologyTest): PsychotraumatologyTestDto
        +create(entity: PsychotraumatologyTest): PsychotraumatologyTest
    }

    class PsychotraumatologyService <<@Service>> {
        +toEntity(dto: PsychotraumatologyTestDto): PsychotraumatologyTest
        +submitTest(dto: PsychotraumatologyTestDto): PsychotraumatologyTest
        +getTestsByClient(clientUuid: UUID, authentication: Authentication): List<PsychotraumatologyTest>
    }
}

package "4. Repository Swimlane" as LaneRepo #E8F8F5 {
    interface "BaseRepository<PsychotraumatologyTest, UUID>" as BaseRepo <<@NoRepositoryBean>> {
    }

    interface PsychotraumatologyTestRepository <<@Repository>> {
        +findByClientUuid(clientUuid: UUID): List<PsychotraumatologyTest>
    }
}

package "5. Hibernate Entity Swimlane" as LaneEntity #FDEDEC {
    abstract class "BaseEntity<UUID>" as BaseEnt <<@MappedSuperclass>> {
        #id: UUID <<@Id @GeneratedValue(UUID)>>
        +getId(): UUID
        +setId(id: UUID): void
    }

    class PsychotraumatologyTest <<@Entity psychotraumatology_tests>> {
        -clientUuid: UUID
        -therapistUuid: UUID
        -testType: String
        -score: Integer
        -severity: String
        -answersJson: String
        -timestamp: LocalDateTime
    }
}

BaseCtrl <|-- PsychotraumatologyController
BaseDto <|.. PsychotraumatologyTestDto
BaseSvc <|-- PsychotraumatologyService
BaseRepo <|-- PsychotraumatologyTestRepository
BaseEnt <|-- PsychotraumatologyTest

PsychotraumatologyController --> PsychotraumatologyService : "@Autowired service"
PsychotraumatologyController ..> PsychotraumatologyTestDto : "@RequestBody"
PsychotraumatologyService ..> PsychotraumatologyTestDto : "toEntity / toDto"
PsychotraumatologyService --> PsychotraumatologyTestRepository : "@Autowired repository"
PsychotraumatologyTestRepository --> PsychotraumatologyTest : "Hibernate ORM"

@enduml
