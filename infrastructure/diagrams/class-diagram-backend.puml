title Backend Klassediagram (com.platform - Java 17 / Spring Boot 3.3 - Generisk Base Arkitektur & Spring IoC DI Swimlanes)

package "Generic Core Base Layer (com.platform.core)" as PkgCore #F9EBEA {
    abstract class "BaseController<E extends BaseEntity<ID>, D extends BaseDTO<ID>, ID>" as BaseController <<AbstractController>> {
        #service: BaseService<E, D, ID> <<@Autowired>>
        +getService(): BaseService<E, D, ID>
        +setService(service: BaseService<E, D, ID>): void
        +getAll(): ResponseEntity<List<D>>
        +getById(id: ID): ResponseEntity<D>
        +create(dto: D): ResponseEntity<D>
        +update(id: ID, dto: D): ResponseEntity<D>
        +delete(id: ID): ResponseEntity<Void>
    }

    interface "BaseDTO<ID extends Serializable>" as BaseDTO <<Serializable>> {
        +getId(): ID
        +setId(id: ID): void
    }

    class "BaseService<E extends BaseEntity<ID>, D extends BaseDTO<ID>, ID>" as BaseService <<@Transactional>> {
        #repository: BaseRepository<E, ID> <<@Autowired>>
        #interceptors: List<CrudInterceptor<E, ID>> <<@Autowired>>
        #entityClass: Class<E>
        #dtoClass: Class<D>
        +getRepository(): BaseRepository<E, ID>
        +setRepository(repository: BaseRepository<E, ID>): void
        +setInterceptors(interceptors: List<CrudInterceptor<E, ID>>): void
        +addInterceptor(interceptor: CrudInterceptor<E, ID>): void
        +toEntity(dto: D): E
        +toDto(entity: E): D
        +findAll(): List<E>
        +findAllDtos(): List<D>
        +findAllDynamic(page: int, size: int, filters: Map<String, String>, sortParam: String): List<E>
        +buildSpecification(filters: Map<String, String>): Specification<E>
        +buildSort(sortParam: String): Sort
        +findById(id: ID): Optional<E>
        +findDtoById(id: ID): Optional<D>
        +getByIdOrThrow(id: ID): E
        +create(entity: E): E
        +createFromDto(dto: D): D
        +save(entity: E): E
        +update(id: ID, entity: E): E
        +updateFromDto(id: ID, dto: D): D
        +deleteById(id: ID): void
        +existsById(id: ID): boolean
        +count(): long
    }

    interface "CrudInterceptor<E extends BaseEntity<ID>, ID>" as CrudInterceptor <<LifecycleHook>> {
        +beforeCreate(entity: E): void
        +afterCreate(entity: E): void
        +beforeUpdate(entity: E): void
        +afterUpdate(entity: E): void
        +beforeDelete(id: ID): void
        +afterDelete(id: ID): void
    }

    interface "BaseRepository<E extends BaseEntity<ID>, ID>" as BaseRepository <<@NoRepositoryBean>> {
        ' Extends JpaRepository<E, ID> & JpaSpecificationExecutor<E>
    }

    abstract class "BaseDAO<T extends BaseEntity<ID>, ID>" as BaseDAO <<GenericDAO>> {
        #entityManager: EntityManager
        #entityClass: Class<T>
        +findAll(): List<T>
        +findById(id: ID): Optional<T>
        +save(entity: T): T
        +deleteById(id: ID): void
        +existsById(id: ID): boolean
        +count(): long
        +findAllDynamic(offset: int, limit: int, filters: Map<String, String>, sortParam: String): List<T>
        #convertValue(val: String, targetType: Class<?>): Object
    }

    abstract class "BaseEntity<ID extends Serializable>" as BaseEntity <<@MappedSuperclass>> {
        #id: ID
        +getId(): ID
        +setId(id: ID): void
    }
}

