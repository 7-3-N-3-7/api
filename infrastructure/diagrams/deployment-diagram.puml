@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.4

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.5
}

skinparam component {
    BackgroundColor #F8F9FA
    BorderColor #2C3E50
    BorderThickness 1.3
}

skinparam database {
    BackgroundColor #EBF5FB
    BorderColor #2C3E50
    BorderThickness 1.4
}

title Deployment Diagram - Containeriseret Cloud & Docker Arkitektur (157.180.43.151.nip.io)

node "Klient Enhed & E2E Test Runner" as ClientDevice #FEF9E7 {
    component "Webbrowser (Klient / Terapeut / Admin)\n& Playwright E2E Runner" as Browser
}

node "Docker Host / Cloud Server (Linux VM - 157.180.43.151)" as DockerHost #F4F6F7 {

    package "Edge & Reverse Proxy Layer (public-net)" as EdgeLayer #FFFFFF {
        component "traefik:v3.1\nReverse Proxy & Let's Encrypt TLS\n[Ports: 80, 443]" as Traefik
        component "oauth2-proxy:v7.6.0\nOIDC Gatekeeper\n[Port: 4180]" as OAuth2Proxy
    }

    package "IAM & Sikkerhedslag (keycloak-net)" as IamLayer #FDEDEC {
        component "keycloak:24.0.4\nlogin.157.180.43.151.nip.io\nRealm: EduJournal [Port: 8080]" as Keycloak
        database "auth-db (postgres:16-alpine)\nKeycloak IAM Database\nVolume: auth_pgdata [Port: 5432]" as AuthDb
    }

    package "Applikationslag (public-net & backend-net)" as AppLayer #EAFAF1 {
        component "frontend (Next.js 16 / React 19 BFF)\nplatform.157.180.43.151.nip.io\nNextAuth + /api/backend/[...path] [Port: 3000]" as Frontend
        component "backend (Spring Boot 3.3 / Java 17)\napi.157.180.43.151.nip.io\nOAuth2 Resource Server [Port: 8081]" as Backend
        database "JGit Fil-Repository\n./journal-repo (patients/<id>.md)\nImmutable SHA-1 Commit Historik" as JGitRepo #E8F8F5
    }

    package "Data, Cache & Event Streaming Lag (backend-net & kafka-net)" as DataLayer #EBF5FB {
        database "business-db (postgres:16-alpine)\nKerneforretning (Klinik, Aftaler, Journal, PCL-5)\nVolume: business_db_data [Port: 5432 / 5433]" as BusinessDb
        database "mongodb (mongo:7.0)\nintegrate_mongo (i18n_dictionaries, transcripts)\nVolume: mongo_data [Port: 27017]" as MongoDb
        database "redis (redis:7-alpine)\nRedisson L2 Distributed Cache\nVolume: redis_data [Port: 6379]" as Redis
        component "kafka (confluentinc/cp-kafka:7.6.0)\nTopics: appointment-events, transcript-events\n[Ports: 9092, 29092]" as Kafka
        component "zookeeper (cp-zookeeper:7.6.0)\nCluster Coordination\n[Port: 2181]" as Zookeeper
    }

    package "Drift & Automatisk Opdatering" as OpsLayer #F2F4F4 {
        component "watchtower (containrrr/watchtower)\nAutomatisk Container Image Rollout\n[/var/run/docker.sock]" as Watchtower
    }
}

' Forbindelser fra Klient
Browser --> Traefik : "HTTPS (443) / HTTP (80)\nOIDC & REST API"
Browser ..> Frontend : "Lokal E2E / Dev (:3000)"
Browser ..> Keycloak : "OIDC Token / Login (:8080)"

' Edge routing
Traefik --> Frontend : "platform.*.nip.io (:3000)"
Traefik --> Backend : "api.*.nip.io (:8081)"
Traefik --> Keycloak : "login.*.nip.io (:8080)"
Traefik --> OAuth2Proxy : "ForwardAuth (:4180)"
OAuth2Proxy --> Keycloak : "OIDC Validering"
OAuth2Proxy --> Redis : "Session Store (:6379)"

' Applikationsforbindelser
Frontend --> Backend : "BFF Proxy (/api/backend/*)\n+ Bearer JWT (:8081)"
Frontend --> Keycloak : "NextAuth OIDC & Admin Sync (:8080)"
Backend --> Keycloak : "JWKS Public Keys & Role Sync (:8080)"
Keycloak --> AuthDb : "JDBC (keycloak-net:5432)"

' Backend persistens & events
Backend --> BusinessDb : "Spring Data JPA / JDBC (:5432)"
Backend --> MongoDb : "Spring Data MongoDB (:27017)"
Backend --> Redis : "Redisson L2 Cache (:6379)"
Backend --> Kafka : "Spring Kafka Producer (:29092)"
Backend --> JGitRepo : "Org.Eclipse.JGit Read/Commit"
Kafka --> Zookeeper : "Metadata (:2181)"

@enduml
