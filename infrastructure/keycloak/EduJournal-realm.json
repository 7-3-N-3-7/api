    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "client",
        "description": "Standard client / patient role"
      },
      {
        "name": "therapist",
        "description": "Clinical therapist / provider role"
      },
      {
        "name": "admin",
        "description": "Clinic management / platform admin role"
      }
