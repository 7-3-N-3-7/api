{
  "name": "frontend-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for the frontend",
  "scripts": {
    "test": "playwright test",
    "cucumber": "node node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:infra": "node node_modules/@cucumber/cucumber/bin/cucumber.js --profile infra",
    "test:ui": "node node_modules/@cucumber/cucumber/bin/cucumber.js --profile ui"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^26.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
