@startuml core-and-slice-class-diagram
!pragma layout smetana
set namespaceSeparator none
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam roundCorner 8
skinparam monochrome false
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.3
    HeaderBackgroundColor #F4F6F7
}

package "com.platform.core" {
    class BaseDomainCore << (F, #ADD1B2) final >> {
        - BaseDomainCore()
    }

    interface "HasId" as HasId {
        + id() : UUID
    }

    interface "Identifiable" as Identifiable {
        + getId() : UUID
        + setId(id : UUID) : void
        + default id() : UUID
    }

    interface "BaseRepository<E extends Identifiable>" as BaseRepository <<JpaRepository>> {
        + findAll(spec : Specification<E>, pageable : Pageable) : Page<E>
    }

    enum ErrorCode {
        NOT_FOUND(404)
        CONFLICT(409)
        BAD_REQUEST(400)
        UNAUTHORIZED(401)
        FORBIDDEN(403)
        UNPROCESSABLE_ENTITY(422)
        INTERNAL_ERROR(500)
        --
        + toException(details : String) : DomainException
        + supply(details : String) : Supplier<DomainException>
        + require(condition : boolean, details : String) : void
    }

    class DomainException {
        - errorCode : ErrorCode
        - timestamp : Instant
        + getStatus() : int
        + getTitle() : String
    }

    abstract class "BaseService<E extends Identifiable, D extends HasId>" as BaseService {
        # repository : BaseRepository<E>
        # {abstract} toDto(entity : E) : D
        # {abstract} toEntity(dto : D) : E
        # mergeEntity(existing : E, dto : D) : E
        # validateBeforeCreate(dto : D) : void
        # validateBeforeUpdate(id : UUID, dto : D) : void
        + findAll() : List<D>
        + findAllPaged(pageable : Pageable) : Page<D>
        + findById(id : UUID) : D
        + create(dto : D) : D
        + update(id : UUID, dto : D) : D
        + deleteById(id : UUID) : void
    }

    class BaseWebCore << (F, #ADD1B2) final >> {
        - BaseWebCore()
    }

    abstract class "BaseController<E extends Identifiable, D extends HasId>" as BaseController {
        # service : BaseService<E, D>
        + getAll() : ResponseEntity<List<D>>
        + getAllPaged(pageable : Pageable) : ResponseEntity<Page<D>>
        + getById(id : UUID) : ResponseEntity<D>
        + create(dto : D) : ResponseEntity<D>
        + update(id : UUID, dto : D) : ResponseEntity<D>
        + delete(id : UUID) : ResponseEntity<Void>
    }

    class GlobalExceptionHandler <<RestControllerAdvice>> {
        + handleDomainException(ex : DomainException, req : HttpServletRequest) : ResponseEntity<ProblemDetail>
        + handleValidationException(ex : MethodArgumentNotValidException, req : HttpServletRequest) : ResponseEntity<ProblemDetail>
    }
}

package "com.platform.features.appointment" {
    class AppointmentFeature << (F, #FFE6CC) Vertical Slice >> {
        - AppointmentFeature()
    }

    class Appointment <<Entity>> {
        - id : UUID
        - clientUuid : UUID
        - therapistUuid : UUID
        - clientName : String
        - startTime : LocalDateTime
        - endTime : LocalDateTime
        - status : String
    }

    class AppointmentDto <<record>> {
        + id : UUID
        + clientUuid : UUID
        + therapistUuid : UUID
        + clientName : String
        + startTime : LocalDateTime
        + endTime : LocalDateTime
        + status : String
    }

    interface "~AppointmentRepository" as AppointmentRepository <<package-private>> {
        + existsByStartTime(startTime : LocalDateTime) : boolean
        + findByTherapistUuid(therapistUuid : UUID) : List<Appointment>
    }

    class "~AppointmentService" as AppointmentService <<package-private>> {
        # validateBeforeCreate(dto : AppointmentDto) : void
        # validateBeforeUpdate(id : UUID, dto : AppointmentDto) : void
        # toDto(e : Appointment) : AppointmentDto
        # toEntity(d : AppointmentDto) : Appointment
    }

    class "~AppointmentController" as AppointmentController <<package-private>> {
    }
}

HasId <|-- Identifiable
Identifiable <|.. Appointment
HasId <|.. AppointmentDto
BaseRepository <|-- AppointmentRepository
BaseService <|-- AppointmentService
BaseController <|-- AppointmentController

BaseService o--> BaseRepository
BaseController o--> BaseService
AppointmentService o--> AppointmentRepository
AppointmentService ..> ErrorCode : uses require()
ErrorCode ..> DomainException : creates via "::new"
GlobalExceptionHandler ..> DomainException : maps to RFC 7807 ProblemDetail
@enduml
